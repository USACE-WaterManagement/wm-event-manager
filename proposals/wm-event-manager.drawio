        <mxCell id="k1J5Uft5zTIaOylSxwT3-6" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1408.5" y="610" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="k1J5Uft5zTIaOylSxwT3-11" value="Since API is already containerized, just orchestrate through ECS.&amp;nbsp; Avoids nitpicking things like polling intervals, cold starts, etc.&amp;nbsp;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1460" y="322" width="449" height="78" as="geometry" />
        </mxCell>
        <mxCell id="k1J5Uft5zTIaOylSxwT3-12" value="&lt;span&gt;Give API access to CloudWatch logs so that it can pull Batch job logs to serve to the front end OR possibly tie into Grafana directly? Probably best to avoid duplicate S3 storage unless needed for some specific reason.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1460.5" y="380.5" width="450" height="55" as="geometry" />
        </mxCell>
        <mxCell id="k1J5Uft5zTIaOylSxwT3-13" value="DynamoDB seems to make sense for this use case.&amp;nbsp; Just make sure to nail down primary lookup, GSIs, and LSIs in Dev because changes to those will require tickets in Test and Prod." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1460.5" y="462" width="450" height="117" as="geometry" />
        </mxCell>
        <mxCell id="k1J5Uft5zTIaOylSxwT3-14" value="Since Batch is the only job runner for now, the overhead of SQS -&amp;gt; ECS/Lambda is probably not needed -- Batch basically does this on its own.&amp;nbsp; Could potentially be a future need if Batch doesn&#39;t perform adequately, though (especially for small, quick tasks)?" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1461" y="530" width="450" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k1J5Uft5zTIaOylSxwT3-15" value="Set up EventBridge to fire a Lambda on Batch Job State Change Event for event-based jobs (detail -&amp;gt; jobName -&amp;gt; prefix: &quot;&quot;).&amp;nbsp; Lambda will update job status in DDB." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1460" y="610.5" width="449" height="49.5" as="geometry" />
        </mxCell>

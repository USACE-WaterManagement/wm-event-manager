        </mxCell>
        <mxCell id="airflow" value="Airflow&lt;br&gt;cwms_batch_events_swt_hourly DAG&lt;br&gt;schedule: 15 * * * *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="210" height="80" as="geometry" />
        </mxCell>

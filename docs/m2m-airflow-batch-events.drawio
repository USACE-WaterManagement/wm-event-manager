          <mxGeometry x="400" y="120" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="batch_api" value="Batch Events API&lt;br&gt;POST /jobs&lt;br&gt;validates JWT, azp allow-list,&lt;br&gt;CDA profile roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="120" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cda_profile" value="CDA /user/profile&lt;br&gt;service account is registered&lt;br&gt;SWT: CWMS Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1030" y="120" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="batch_db" value="Batch Events DB&lt;br&gt;scripts + jobs&lt;br&gt;SWT hourly =&gt; bin/hourly.sh&lt;br&gt;runtime=shell" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="310" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="Queue&lt;br&gt;SQS / ElasticMQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1030" y="320" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dispatcher" value="Dispatcher&lt;br&gt;Lambda / local loop&lt;br&gt;submits runtime job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="470" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="aws_batch" value="AWS Batch / Local Docker&lt;br&gt;shared shell runner jobdef&lt;br&gt;not per-office jobdefs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="520" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="runtime_broker" value="Runtime env broker&lt;br&gt;GET /internal/jobs/{job}/runtime-env&lt;br&gt;per-job runtime token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="Secrets Manager / local JSON&lt;br&gt;cwms-batch-jobs-swd-secrets&lt;br&gt;SWT_CDA_CLIENT_ID/SECRET" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="515" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="runner" value="Runner container&lt;br&gt;cwbi-wm-images&lt;br&gt;loads runtime env, then gets CDA token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="runner_client" value="Runner identity&lt;br&gt;Keycloak confidential client&lt;br&gt;cwms-batch-runner-swt&lt;br&gt;machine_auth + run_as_office=SWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="715" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cda_api" value="CDA API&lt;br&gt;validates runner access token&lt;br&gt;registered machine principal&lt;br&gt;office-scoped roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="720" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="office_scripts" value="SWT office repo&lt;br&gt;swt-wm-cwbi-jobs&lt;br&gt;bin/hourly.sh&lt;br&gt;Python uses CDA_BEARER_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="870" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Important separation&lt;br&gt;Airflow client is allowed to schedule the job.&lt;br&gt;Runner client is the machine identity used inside CDA.&lt;br&gt;Batch Events stores the authorization decision and brokers only the env/secrets requested by the script." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1. client_credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="airflow_client" target="keycloak">
          <mxGeometry relative="1" as="geometry" />

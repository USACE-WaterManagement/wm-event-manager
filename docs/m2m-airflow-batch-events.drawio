<mxfile host="app.diagrams.net" version="29.2.4">
  <diagram id="m2m-airflow-batch-events" name="M2M Airflow Batch Events">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Scheduled Office Job Flow: Airflow -&gt; Batch Events -&gt; CDA" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="40" as="geometry" />

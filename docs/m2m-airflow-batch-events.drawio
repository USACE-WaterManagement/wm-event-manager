          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="8. submit shared runtime job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="dispatcher" target="aws_batch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="9. runner asks for job env" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="runner" target="runtime_broker">
